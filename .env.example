# Supabase project credentials.
# Find these in your Supabase dashboard: Project Settings -> Data API / API Keys.
# Both are safe to expose in the browser bundle (this app uses the public anon
# key with open RLS by design). Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Admin PIN required to edit or delete saved games. Server-only (do NOT prefix with NEXT_PUBLIC).
# Defaults to 1234 if unset, so set your own in production.
# Vercel Preview deployments have no Supabase variables by default and render the
# setup/error screen. For working previews, give Preview its own NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_ANON_KEY and ADMIN_PIN pointing at a separate test project, never production.
ADMIN_PIN=1234
